{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/kit",
      "destination": "/kit.html"
    },
    {
      "source": "/kit/",
      "destination": "/kit.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/sobre/",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/contato",
      "destination": "/contato/index.html"
    },
    {
      "source": "/contato/",
      "destination": "/contato/index.html"
    },
    {
      "source": "/ajuda",
      "destination": "/ajuda/index.html"
    },
    {
      "source": "/ajuda/",
      "destination": "/ajuda/index.html"
    },
    {
      "source": "/trocas-e-devolucoes",
      "destination": "/trocas-e-devolucoes/index.html"
    },
    {
      "source": "/trocas-e-devolucoes/",
      "destination": "/trocas-e-devolucoes/index.html"
    },
    {
      "source": "/rastrear-pedido",
      "destination": "/rastrear-pedido/index.html"
    },
    {
      "source": "/rastrear-pedido/",
      "destination": "/rastrear-pedido/index.html"
    },
    {
      "source": "/entrega",
      "destination": "/entrega/index.html"
    },
    {
      "source": "/entrega/",
      "destination": "/entrega/index.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/privacidade/",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/termos",
      "destination": "/termos/index.html"
    },
    {
      "source": "/termos/",
      "destination": "/termos/index.html"
    },
    {
      "source": "/bermudas",
      "destination": "/bermudas/index.html"
    },
    {
      "source": "/bermudas/",
      "destination": "/bermudas/index.html"
    },
    {
      "source": "/moda-masculina",
      "destination": "/moda-masculina/index.html"
    },
    {
      "source": "/moda-masculina/",
      "destination": "/moda-masculina/index.html"
    },
    {
      "source": "/mais-vendidos",
      "destination": "/mais-vendidos/index.html"
    },
    {
      "source": "/mais-vendidos/",
      "destination": "/mais-vendidos/index.html"
    },
    {
      "source": "/bermuda",
      "destination": "/bermuda.html"
    },
    {
      "source": "/bermuda/",
      "destination": "/bermuda.html"
    },
    {
      "source": "/bermuda2",
      "destination": "/bermuda2.html"
    },
    {
      "source": "/bermuda2/",
      "destination": "/bermuda2.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
